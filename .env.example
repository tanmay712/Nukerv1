# Set this to the exact public HTTPS origin, without a trailing slash.
# For local testing only, http://localhost:6546 is also accepted.
PUBLIC_BASE_URL=https://cryply.xyz
# Generate a long random value locally. Never share or commit it.
SESSION_SECRET=
# Set to 1 only if running behind a trusted TLS-terminating reverse proxy.
TRUST_PROXY=0
# Register exact callbacks: <PUBLIC_BASE_URL>/auth/google/callback and /auth/discord/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Numeric immutable Discord user ID; only this Discord identity has owner access.
OWNER_DISCORD_ID=
# Server-only MongoDB connection string. Never commit or share it.
# Set this for persistent data on Render; use a replica set / Atlas cluster.
MONGODB_URI=
MONGODB_DB_NAME=cryply
# Tatum key for the owner-only Solana devnet connection check. Never share it.
TATUM_API_KEY=
# Experimental and not live-provider tested; leave disabled for customers.
ENABLE_EXPERIMENTAL_TATUM_DEVNET=0
# Optional legacy read-only Coinbase Prime configuration (not used by Tatum).
COINBASE_PRIME_ACCESS_KEY=
COINBASE_PRIME_SIGNING_KEY=
COINBASE_PRIME_PASSPHRASE=
COINBASE_PRIME_PORTFOLIO_ID=
# Entity ID for read-only supported-asset and network metadata.
COINBASE_PRIME_ENTITY_ID=
# Internal port for the web server. A reverse proxy exposes HTTPS on the domain.
PORT=6546
# Transactional email via authenticated SMTP. Use TLS (465) or STARTTLS (587).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# A verified sender mailbox at your mail provider (no display name).
MAIL_FROM=
